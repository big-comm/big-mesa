prepare() {
  cd mesa-$pkgver
  echo "$pkgver-big$pkgrel" >VERSION
}

# Parallel jobs: all CPUs by default (the CI). MESA_BIG_JOBS=4 keeps a local
# build from taking a desktop's memory: each LLVM compile job needs ~1.5 GB.
_jobs=${MESA_BIG_JOBS:-$(nproc)}

_build_llvm() {
  # As in ../mesa-big, for i686. lib32-zlib, found by hand: CMake would take
  # the 64-bit one.
  CC="gcc -m32" CXX="g++ -m32" \
  cmake -S llvm-project-$_llvmver.src/llvm -B build-llvm -G Ninja \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_INSTALL_PREFIX="$srcdir/llvm-static" \
    -D LLVM_TARGETS_TO_BUILD="X86;AMDGPU" \
    -D LLVM_HOST_TRIPLE=i686-pc-linux-gnu \
    -D LLVM_LIBDIR_SUFFIX= \
    -D BUILD_SHARED_LIBS=OFF \
    -D LLVM_BUILD_LLVM_DYLIB=OFF \
    -D LLVM_LINK_LLVM_DYLIB=OFF \
    -D LLVM_ENABLE_PIC=ON \
    -D LLVM_ENABLE_RTTI=ON \
    -D LLVM_ENABLE_ASSERTIONS=OFF \
    -D LLVM_BUILD_TOOLS=OFF \
    -D LLVM_INCLUDE_TESTS=OFF \
    -D LLVM_INCLUDE_EXAMPLES=OFF \
    -D LLVM_INCLUDE_BENCHMARKS=OFF \
    -D LLVM_INCLUDE_DOCS=OFF \
    -D LLVM_ENABLE_BINDINGS=OFF \
    -D LLVM_ENABLE_ZLIB=FORCE_ON \
    -D ZLIB_LIBRARY=/usr/lib32/libz.so \
    -D ZLIB_INCLUDE_DIR=/usr/include \
    -D LLVM_ENABLE_ZSTD=OFF \
    -D LLVM_ENABLE_LIBXML2=OFF \
    -D LLVM_ENABLE_LIBEDIT=OFF \
    -D LLVM_ENABLE_LIBPFM=OFF \
    -D LLVM_ENABLE_FFI=OFF \
    -D LLVM_PARALLEL_LINK_JOBS=1
  cmake --build build-llvm -j "$_jobs" --target install-llvm-headers install-llvm-libraries \
    install-cmake-exports llvm-config
  # A 32-bit program; it runs on the build machine with lib32-glibc.
  install -Dm755 build-llvm/bin/llvm-config -t "$srcdir/llvm-static/bin"
}

_build_tools() {
  # The same build tools as ../mesa-big, for the build machine.
  arch-meson mesa-$pkgver build-tools \
    --auto-features auto \
    -D gallium-drivers= \
    -D vulkan-drivers=intel \
    -D intel-rt=enabled \
    -D llvm=enabled \
    -D shared-llvm=enabled \
    -D mesa-clc=enabled \
    -D install-mesa-clc=true \
    -D precomp-compiler=enabled \
    -D install-precomp-compiler=true \
    -D platforms= \
    -D glx=disabled -D egl=disabled -D gbm=disabled -D gles1=disabled -D gles2=disabled \
    -D opengl=false -D valgrind=disabled -D libunwind=disabled
  meson compile -C build-tools -j "$_jobs"
  meson install -C build-tools --destdir "$srcdir/tools"
}

build() {
  export MESON_PACKAGE_CACHE_DIR="$srcdir"
  _build_llvm
  _build_tools

  # Meson merges cross files: lib32 (from meson) for i686, this one for the
  # LLVM built above.
  printf '[binaries]\nllvm-config = %s\n' "'$srcdir/llvm-static/bin/llvm-config'" > cross-llvm.ini
  local meson_options=(
    --cross-file lib32
    --cross-file cross-llvm.ini
    --optimization 2
    -D b_ndebug=true
    -D android-libbacktrace=disabled
    -D gallium-drivers=radeonsi,iris,crocus,zink,virgl,llvmpipe
    -D gallium-extra-hud=true
    -D gallium-mediafoundation=disabled
    -D gallium-rusticl=false
    -D gles1=disabled
    -D html-docs=disabled
    -D intel-rt=disabled
    -D libunwind=disabled
    -D llvm=enabled
    -D shared-llvm=disabled
    -D amd-use-llvm=false
    -D amdgpu-virtio=true
    -D intel-virtio-experimental=true
    -D mesa-clc=system
    -D precomp-compiler=system
    -D microsoft-clc=disabled
    -D valgrind=disabled
    -D video-codecs=all
    -D vulkan-drivers=amd,intel,intel_hasvk,nouveau,virtio
    -D vulkan-layers=device-select,overlay,anti-lag,screenshot,vram-report-limit
    -D vulkan-loader-rpath=
    -D vulkan-manifest-per-architecture=false
    # Simulated GPUs (drm-shim) for check(); package() leaves them out.
    # Intel's simulated GPU is built with the Intel tools.
    -D tools=drm-shim,intel
  )
  PATH="$srcdir/tools/usr/bin:$PATH" arch-meson mesa-$pkgver build "${meson_options[@]}"
  PATH="$srcdir/tools/usr/bin:$PATH" meson compile -C build -j "$_jobs"
}

check() {
  # 1. Nothing in the package may need lib32-llvm-libs.
  local lib missing=0
  while IFS= read -r lib; do
    if ldd "$lib" 2>/dev/null | grep -q 'libLLVM'; then
      echo "links libLLVM: $lib"; missing=1
    fi
  done < <(find build -name '*.so*' -type f)
  (( missing == 0 )) || return 1

  # 2. What a 32-bit game does first, against the drivers built here.
  local root=$srcdir/check-root version="Mesa $pkgver-big$pkgrel" out
  rm -rf "$root"
  meson install -C build --destdir "$root" --quiet
  lib=$root/usr/lib32
  gcc -m32 -O2 -o test-lib32 test-lib32.c -lEGL -lGL -lvulkan
  if [[ $(file -b test-lib32) != ELF\ 32-bit* ]]; then
    echo "test-lib32 is not a 32-bit program"; return 1
  fi
  local env=(
    LD_LIBRARY_PATH="$lib"
    __EGL_VENDOR_LIBRARY_FILENAMES="$root/usr/share/glvnd/egl_vendor.d/50_mesa.json"
    LIBGL_DRIVERS_PATH="$lib/dri"
    MESA_SHADER_CACHE_DISABLE=true
  )

  # OpenGL on llvmpipe: the static i686 LLVM compiling and running shaders.
  out=$(env "${env[@]}" LIBGL_ALWAYS_SOFTWARE=1 ./test-lib32 gl 2>&1)
  echo "$out"
  if ! grep -q "GL_RENDERER: llvmpipe (LLVM $_llvmver" <<<"$out" ||
     ! grep -q "GL_VERSION: .*$version" <<<"$out"; then
    echo "32-bit OpenGL on llvmpipe did not report $version with LLVM $_llvmver"; return 1
  fi

  # Vulkan on simulated GPUs.
  local -A shim=([amd]=libamdgpu_noop_drm_shim.so [intel]=libintel_noop_drm_shim.so)
  local -A icd=([amd]=radeon_icd.json [intel]=intel_icd.json)
  local gpu
  for gpu in amd intel; do
    out=$(env "${env[@]}" LD_PRELOAD="$lib/${shim[$gpu]}" \
      VK_DRIVER_FILES="$root/usr/share/vulkan/icd.d/${icd[$gpu]}" \
      ./test-lib32 vulkan 2>&1)
    echo "$out"
    if ! grep -q "driverInfo: $version" <<<"$out"; then
      echo "32-bit Vulkan on a simulated $gpu GPU did not report $version"; return 1
    fi
  done
}

package() {
  meson install -C build --destdir "$pkgdir"
  # The simulated GPUs and the Intel tools were only for check(); the Intel
  # tools' libraries go to /usr/lib whatever the libdir.
  rm -fv "$pkgdir"/usr/lib32/lib*_noop_drm_shim.so \
    "$pkgdir"/usr/lib/lib{intel_dump_gpu,intel_sanitize_gpu}.so
  rmdir "$pkgdir"/usr/lib
  # Everything outside lib32 comes with the 64-bit half.
  rm -rf "$pkgdir"/{etc,usr/bin,usr/include,usr/share}
  # Indirect GLX (remote X clients) through libglvnd, as Arch's lib32-mesa does.
  ln -sr "$pkgdir"/usr/lib32/libGLX_{mesa,indirect}.so.0

  local extra
  extra=$(find "$pkgdir" -mindepth 1 -maxdepth 2 ! -path "$pkgdir/usr" ! -path "$pkgdir/usr/lib32")
  if [[ -n $extra ]]; then
    error "unexpected files outside /usr/lib32:"; printf '  %s\n' $extra; return 1
  fi
  install -Dm644 mesa-$pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 llvm-project-$_llvmver.src/llvm/LICENSE.TXT \
    "$pkgdir/usr/share/licenses/$pkgname/LLVM-LICENSE.TXT"
}
