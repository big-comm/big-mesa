# Maintainer: Tales A. Mendonça <talesam@gmail.com>
#
# lib32-mesa-big: the 32-bit half of mesa-big, for 32-bit games (Steam, Wine).
# Same Mesa release, same drivers and the same choices as ../mesa-big (read
# its header), built for i686:
#
#   - LLVM built here for i686, static, linked in: no lib32-llvm-libs.
#   - mesa-clc and the Intel precompiled-shader compiler are build tools:
#     they are built for the build machine (x86_64, system LLVM) and the
#     32-bit drivers are built with them.
#   - No Intel ray tracing in 32-bit, as in Arch's lib32-mesa.
#   - check() runs what a 32-bit game does first: OpenGL through EGL on
#     llvmpipe (the static LLVM at work), and Vulkan on simulated AMD and
#     Intel GPUs (drm-shim).
#
# Keep pkgver and _llvmver equal to ../mesa-big's.

pkgname=lib32-mesa-big
pkgver=26.2.5
pkgrel=1
_llvmver=23.1.4
# lib32-spirv-tools from Manjaro stable this was built against: its library has no
# versioned soname, so the watcher rebuilds (pkgrel + 1) when it changes.
_spirvtools=1:1.4.357.0-1
pkgdesc="Mesa from mesa3d.org, latest stable release, with LLVM built in (BigCommunity) - 32-bit"
url="https://www.mesa3d.org/"
arch=('x86_64')
license=('MIT AND BSD-3-Clause AND SGI-B-2.0' 'Apache-2.0 WITH LLVM-exception')
depends=(
  lib32-expat lib32-gcc-libs lib32-glibc lib32-libdisplay-info lib32-libdrm
  lib32-libelf lib32-libglvnd lib32-libpng lib32-libx11 lib32-libxcb
  lib32-libxext lib32-libxshmfence lib32-libxxf86vm lib32-lm_sensors
  lib32-spirv-tools lib32-systemd lib32-vulkan-icd-loader lib32-wayland
  lib32-xcb-util-keysyms lib32-zlib lib32-zstd
  # The 64-bit half: Vulkan manifests, EGL vendor file, drirc. mesa-big
  # provides it; not mesa-big itself, so the CI can install it to build.
  mesa
)
makedepends=(
  # Mesa, 32-bit
  lib32-libva lib32-libxrandr lib32-rust-libs
  # Mesa, build machine
  cbindgen cmake glslang libclc meson ninja python-mako python-packaging
  python-ply python-pycparser python-yaml rust rust-bindgen wayland-protocols
  xorgproto
  # mesa-clc and the precompiled-shader compiler, built with the system LLVM
  clang llvm spirv-llvm-translator
  # check()
  libglvnd vulkan-headers
)
_mesaver=1:$pkgver-$pkgrel
provides=(
  "lib32-mesa=$_mesaver" "lib32-mesa-libgl=$_mesaver" "lib32-libva-mesa-driver=$_mesaver"
  "lib32-vulkan-intel=$_mesaver" "lib32-vulkan-radeon=$_mesaver"
  "lib32-vulkan-nouveau=$_mesaver" "lib32-vulkan-virtio=$_mesaver"
  "lib32-vulkan-mesa-layers=$_mesaver" "lib32-vulkan-mesa-implicit-layers=$_mesaver"
  lib32-libva-driver lib32-opengl-driver lib32-vulkan-driver
)
conflicts=(
  lib32-mesa lib32-mesa-libgl lib32-libva-mesa-driver lib32-vulkan-intel
  lib32-vulkan-radeon lib32-vulkan-nouveau lib32-vulkan-virtio
  lib32-vulkan-mesa-layers lib32-vulkan-mesa-implicit-layers
)
options=(
  # Mesa rejects LTO, and makepkg.conf turns it on by default.
  !lto
)
source=(
  "https://archive.mesa3d.org/mesa-$pkgver.tar.xz"
  "https://github.com/llvm/llvm-project/releases/download/llvmorg-$_llvmver/llvm-project-$_llvmver.src.tar.xz"
  test-lib32.c
)
# Pinned by checksum; the release managers' keys are in ../mesa-big/keys/pgp
# (see the README).

