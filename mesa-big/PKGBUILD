# Maintainer: Tales A. Mendonça <talesam@gmail.com>
#
# mesa-big: Mesa straight from mesa3d.org, the latest stable release, for
# whoever opts in (games, new GPUs). The ISO and everyone else keep Manjaro's
# mesa; installing this replaces it, installing mesa again brings it back.
#
#   - Drivers for PC GPUs and virtual machines: radeonsi, iris, crocus, zink,
#     virgl and llvmpipe (OpenGL; llvmpipe is the software fallback, softpipe
#     is left out: it only runs where LLVM is missing, and here it never is);
#     RADV, ANV, hasvk, NVK and venus (Vulkan).
#     No lavapipe.
#   - Built with GCC, as Arch and Manjaro build Mesa: against clang it
#     compiled shader-db 3-4% faster (CPU cycles, 4263 shaders, radeonsi).
#   - No LTO: Mesa rejects it, and so does this package (!lto below).
#   - LLVM built here, static, and linked into the package: mesa-big does
#     not depend on llvm-libs, so it keeps working when Manjaro moves LLVM
#     (stable and testing differ). radeonsi and RADV compile with ACO
#     (amd-use-llvm=false; ACO is radeonsi's default since Mesa 26.0), so only
#     llvmpipe uses LLVM. The AMDGPU target is still built: meson.build asks
#     for it whenever radeonsi or RADV is built, whatever amd-use-llvm says
#     (as of Mesa 26.2.5 and main on 2026-10-25). Being static, none of it
#     ends up in the package: the linker only takes what Mesa calls.
#   - Virtual machines: amdgpu and Intel native contexts (the native drivers
#     inside a guest), plus virgl and venus for hosts without them.
#   - mesa-clc and the Intel precompiled-shader compiler (ray tracing) are
#     build tools only: they are built first against the system LLVM and
#     clang, and the drivers are then built with them.

pkgname=mesa-big
pkgver=26.2.5
pkgrel=1
_llvmver=23.1.4
_shaderdb=6ec450899fb1cb9d6d4829bbf864288c4e7a5dbb
pkgdesc="Mesa from mesa3d.org, latest stable release, with LLVM built in (BigCommunity)"
url="https://www.mesa3d.org/"
arch=('x86_64')
license=('MIT AND BSD-3-Clause AND SGI-B-2.0' 'Apache-2.0 WITH LLVM-exception')
depends=(
  expat glibc libdisplay-info libdrm libelf libgcc libglvnd libpng libstdc++
  libx11 libxcb libxext libxshmfence libxxf86vm lm_sensors python spirv-tools
  systemd-libs vulkan-icd-loader wayland xcb-util-keysyms zlib zstd
)
makedepends=(
  # Mesa
  cbindgen cmake directx-headers elfutils glslang libclc libva libxml2
  libxrandr meson ninja python-mako python-packaging python-ply
  python-pycparser python-yaml rust rust-bindgen wayland-protocols xorgproto
  # mesa-clc and the precompiled-shader compiler, built with the system LLVM
  clang llvm spirv-llvm-translator
  # check(): vulkaninfo, and shader-db's runner
  git libepoxy vulkan-tools
)
_mesaver=1:$pkgver-$pkgrel
provides=(
  "mesa=$_mesaver" "mesa-libgl=$_mesaver" "libva-mesa-driver=$_mesaver"
  "vulkan-intel=$_mesaver" "vulkan-radeon=$_mesaver" "vulkan-nouveau=$_mesaver"
  "vulkan-virtio=$_mesaver"
  "vulkan-mesa-layers=$_mesaver" "vulkan-mesa-implicit-layers=$_mesaver"
  libva-driver opengl-driver vulkan-driver
)
conflicts=(
  mesa mesa-libgl libva-mesa-driver vulkan-intel vulkan-radeon vulkan-nouveau
  vulkan-virtio
  vulkan-mesa-layers vulkan-mesa-implicit-layers
)
options=(
  # Mesa rejects LTO ("random issues that are nearly impossible to debug"),
  # and makepkg.conf turns it on by default.
  !lto
)
source=(
  "https://archive.mesa3d.org/mesa-$pkgver.tar.xz"
  "https://github.com/llvm/llvm-project/releases/download/llvmorg-$_llvmver/llvm-project-$_llvmver.src.tar.xz"
  # Real shaders from games and apps, compiled by check() on simulated GPUs.
  "git+https://gitlab.freedesktop.org/mesa/shader-db.git#commit=$_shaderdb"
)
# The Mesa and LLVM tarballs are pinned by checksum. Their release managers'
# keys are in keys/pgp/: check the .sig with them before updating a checksum
# (see the README). The CI does not import keys, so the build itself does not
# download the signatures.

