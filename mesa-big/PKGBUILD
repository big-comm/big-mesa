prepare() {
  cd mesa-$pkgver
  # Shown by glxinfo / vulkaninfo, and makes browsers drop their GPU caches.
  echo "$pkgver-big$pkgrel" >VERSION
}

# Parallel jobs: all CPUs by default (the CI). MESA_BIG_JOBS=4 keeps a local
# build from taking a desktop's memory: each LLVM compile job needs ~1.5 GB.
_jobs=${MESA_BIG_JOBS:-$(nproc)}

_build_llvm() {
  # X86 for llvmpipe; AMDGPU only for meson's check (see the header). No zstd: LLVM then
  # exports it as -lzstd.so.<version>, which breaks static linking
  # (bbs.archlinux.org/viewtopic.php?id=305005); zlib links fine.
  cmake -S llvm-project-$_llvmver.src/llvm -B build-llvm -G Ninja \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_INSTALL_PREFIX="$srcdir/llvm-static" \
    -D LLVM_TARGETS_TO_BUILD="X86;AMDGPU" \
    -D LLVM_HOST_TRIPLE=x86_64-pc-linux-gnu \
    -D BUILD_SHARED_LIBS=OFF \
    -D LLVM_BUILD_LLVM_DYLIB=OFF \
    -D LLVM_LINK_LLVM_DYLIB=OFF \
    -D LLVM_ENABLE_PIC=ON \
    -D LLVM_ENABLE_RTTI=ON \
    -D LLVM_ENABLE_ASSERTIONS=OFF \
    -D LLVM_BUILD_TOOLS=OFF \
    -D LLVM_INCLUDE_TESTS=OFF \
    -D LLVM_INCLUDE_EXAMPLES=OFF \
    -D LLVM_INCLUDE_BENCHMARKS=OFF \
    -D LLVM_INCLUDE_DOCS=OFF \
    -D LLVM_ENABLE_BINDINGS=OFF \
    -D LLVM_ENABLE_ZLIB=FORCE_ON \
    -D LLVM_ENABLE_ZSTD=OFF \
    -D LLVM_ENABLE_LIBXML2=OFF \
    -D LLVM_ENABLE_LIBEDIT=OFF \
    -D LLVM_ENABLE_LIBPFM=OFF \
    -D LLVM_ENABLE_FFI=OFF \
    -D LLVM_PARALLEL_LINK_JOBS=1
  cmake --build build-llvm -j "$_jobs" --target install-llvm-headers install-llvm-libraries \
    install-cmake-exports llvm-config
  # llvm-config is how Mesa finds LLVM. With LLVM_BUILD_TOOLS=OFF it has no
  # install target; it works out the prefix from where it is run from.
  install -Dm755 build-llvm/bin/llvm-config -t "$srcdir/llvm-static/bin"
}

_build_tools() {
  # mesa-clc and the precompiled-shader compiler run only during the build,
  # so they use the system LLVM and clang; the drivers then use them.
  # --auto-features auto: arch-meson enables every auto feature, and with no
  # platform and no drivers some of them (xlib-lease) cannot exist.
  arch-meson mesa-$pkgver build-tools \
    --auto-features auto \
    -D gallium-drivers= \
    -D vulkan-drivers=intel \
    -D intel-rt=enabled \
    -D llvm=enabled \
    -D shared-llvm=enabled \
    -D mesa-clc=enabled \
    -D install-mesa-clc=true \
    -D precomp-compiler=enabled \
    -D install-precomp-compiler=true \
    -D platforms= \
    -D glx=disabled -D egl=disabled -D gbm=disabled -D gles1=disabled -D gles2=disabled \
    -D opengl=false -D valgrind=disabled -D libunwind=disabled
  meson compile -C build-tools -j "$_jobs"
  meson install -C build-tools --destdir "$srcdir/tools"
}

build() {
  export MESON_PACKAGE_CACHE_DIR="$srcdir"
  _build_llvm
  _build_tools

  printf '[binaries]\nllvm-config = %s\n' "'$srcdir/llvm-static/bin/llvm-config'" > native-llvm.ini
  local meson_options=(
    --native-file native-llvm.ini
    --optimization 2
    -D b_ndebug=true
    -D android-libbacktrace=disabled
    -D gallium-drivers=radeonsi,iris,crocus,zink,virgl,llvmpipe
    -D gallium-extra-hud=true
    -D gallium-mediafoundation=disabled
    -D gallium-rusticl=false
    -D gles1=disabled
    -D html-docs=disabled
    -D intel-rt=enabled
    -D libunwind=disabled
    -D llvm=enabled
    -D shared-llvm=disabled
    -D amd-use-llvm=false
    -D amdgpu-virtio=true
    -D intel-virtio-experimental=true
    -D mesa-clc=system
    -D precomp-compiler=system
    -D microsoft-clc=disabled
    -D valgrind=disabled
    -D video-codecs=all
    -D vulkan-drivers=amd,intel,intel_hasvk,nouveau,virtio
    -D vulkan-layers=device-select,overlay,anti-lag,screenshot,vram-report-limit
    -D vulkan-loader-rpath=
    -D vulkan-manifest-per-architecture=false
    # Simulated GPUs (drm-shim) for check(); package() leaves them out.
    -D tools=drm-shim,intel
  )
  PATH="$srcdir/tools/usr/bin:$PATH" arch-meson mesa-$pkgver build "${meson_options[@]}"
  PATH="$srcdir/tools/usr/bin:$PATH" meson compile -C build -j "$_jobs"
}

# What -D tools=drm-shim,intel installs, which only check() uses: the
# simulated GPUs and Intel's debugging tools (Mesa does not install them
# without that option, and neither does Arch's mesa).
_remove_test_tools() {
  rm -fv "$pkgdir"/usr/lib/lib*_noop_drm_shim.so \
    "$pkgdir"/usr/lib/lib{intel_dump_gpu,intel_sanitize_gpu}.so
  rm -fv "$pkgdir"/usr/bin/{aubinator,aubinator_error_decode,elk_asm,elk_disasm,gentool} \
    "$pkgdir"/usr/bin/{intel_dev_info,intel_dump_gpu,intel_error2aub,intel_error2hangdump} \
    "$pkgdir"/usr/bin/{intel_hang_replay,intel_measure.py,intel_monitor,intel_sanitize_gpu} \
    "$pkgdir"/usr/bin/{intel_stub_gpu,mda}

  # A tool a newer Mesa adds must not slip into the package unnoticed.
  local extra
  extra=$(find "$pkgdir/usr/bin" -type f \
    ! -name mesa-overlay-control.py ! -name mesa-screenshot-control.py)
  if [[ -n $extra ]]; then
    error "unexpected files in /usr/bin:"; printf '  %s\n' $extra; return 1
  fi
}

# The GPU code shader-db produced, summed over every shader. Deterministic,
# unlike timings: a release that compiles the same shaders into bigger or
# slower code, or spills more, shows up here exactly.
_shaderdb_summary() { # gpu file
  case $1 in
    amd) awk '/Shader Stats:/ { n++
           for (i = 2; i <= NF; i++) {
             if ($(i-1) == "Code" && $i == "Size:") size += $(i+1)
             if ($i == "VGPRS:") vgprs += $(i+1)
             if ($(i-1) == "Spilled" && $i == "VGPRs:") spilled += $(i+1)
           } }
         END { printf "amd shaders=%d code_size=%d vgprs=%d spilled_vgprs=%d\n", n, size, vgprs, spilled }' "$2" ;;
    intel) awk '/ shader: [0-9]+ inst,/ { n++
           for (i = 2; i <= NF; i++) {
             if ($i == "inst,") inst += $(i-1)
             if ($i == "cycles,") cycles += $(i-1)
             if ($i == "spills:fills,") { split($(i-1), sf, ":"); spills += sf[1]; fills += sf[2] }
           } }
         END { printf "intel shaders=%d inst=%d cycles=%d spills=%d fills=%d\n", n, inst, cycles, spills, fills }' "$2" ;;
  esac
}

# Warns, without failing the build, when a metric got more than 2% worse
# than shaderdb-baseline.txt, the previous release's summary. Every metric
# here is lower-is-better, except the shader count, which must not drop.
_shaderdb_compare() { # summary-file
  local baseline=$startdir/shaderdb-baseline.txt
  [[ -f $baseline ]] || { warning "no shaderdb-baseline.txt to compare with"; return 0; }
  awk -v warnings="$srcdir/shaderdb-warnings.txt" '
    function load(line, into,   f, i, kv) {
      split(line, f, " ")
      for (i = 2; i in f; i++) { split(f[i], kv, "="); into[f[1] " " kv[1]] = kv[2] }
    }
    FNR == NR { load($0, base); next }
    { load($0, now) }
    END {
      for (k in now) {
        if (!(k in base)) continue
        split(k, gm, " ")
        if (gm[2] == "shaders") bad = now[k] < base[k]
        else bad = now[k] > base[k] * 1.02 || (gm[2] ~ /spill|fill/ && now[k] > base[k])
        if (bad) printf "%s %s: %s -> %s\n", gm[1], gm[2], base[k], now[k] > warnings
      }
    }' "$baseline" "$1"
  if [[ -s $srcdir/shaderdb-warnings.txt ]]; then
    warning "shader-db: worse code than the baseline (previous release):"
    sed 's/^/    /' "$srcdir/shaderdb-warnings.txt"
  else
    msg2 "shader-db: no regression against the baseline"
  fi
}

check() {
  # 1. The point of the static LLVM: nothing in the package may need llvm-libs.
  local lib missing=0
  while IFS= read -r lib; do
    if ldd "$lib" 2>/dev/null | grep -q 'libLLVM'; then
      echo "links libLLVM: $lib"; missing=1
    fi
  done < <(find build -name '*.so*' -type f)
  (( missing == 0 )) || return 1

  # 2. The drivers built here, on simulated GPUs (Mesa's drm-shim): they must
  #    load, report this version, and compile real shaders without crashing.
  #    The shader-db results are kept in $srcdir for comparing releases.
  local root=$srcdir/check-root version="Mesa $pkgver-big$pkgrel"
  rm -rf "$root"
  meson install -C build --destdir "$root" --quiet
  lib=$root/usr/lib
  local env=(
    LD_LIBRARY_PATH="$lib" LIBGL_DRIVERS_PATH="$lib/dri" GBM_BACKENDS_PATH="$lib/gbm"
    __EGL_VENDOR_LIBRARY_FILENAMES="$root/usr/share/glvnd/egl_vendor.d/50_mesa.json"
    MESA_SHADER_CACHE_DISABLE=true
  )
  local -A shim=([amd]=libamdgpu_noop_drm_shim.so [intel]=libintel_noop_drm_shim.so)
  local -A icd=([amd]=radeon_icd.json [intel]=intel_icd.json)
  local gpu out compiled

  for gpu in amd intel; do
    out=$srcdir/check-vulkan-$gpu.txt
    env "${env[@]}" LD_PRELOAD="$lib/${shim[$gpu]}" \
      VK_DRIVER_FILES="$root/usr/share/vulkan/icd.d/${icd[$gpu]}" \
      vulkaninfo --summary > "$out" 2>&1
    if ! grep -q "driverInfo *= $version" "$out"; then
      echo "Vulkan on a simulated $gpu GPU did not report $version:"; tail -20 "$out"; return 1
    fi
  done

  # Through the environment: shader-db's Makefile appends -fopenmp to CFLAGS,
  # which a command-line CFLAGS would override.
  CFLAGS="-O2 -I$root/usr/include" LDFLAGS="-L$lib" make -C shader-db run
  : > "$srcdir/shaderdb-summary.metrics"
  for gpu in amd intel; do
    out=$srcdir/check-shaderdb-$gpu.txt
    if ! (cd shader-db && env "${env[@]}" LD_PRELOAD="$lib/${shim[$gpu]}" \
          ./run -j "$_jobs" shaders > "$out" 2>&1); then
      echo "shader-db failed on a simulated $gpu GPU:"; tail -20 "$out"; return 1
    fi
    compiled=$(awk '/took .* seconds and compiled/ { n += $8 } END { print n + 0 }' "$out")
    echo "shader-db, simulated $gpu GPU: $compiled shaders compiled"
    if (( compiled < 8000 )); then
      echo "too few shaders compiled on a simulated $gpu GPU"; tail -20 "$out"; return 1
    fi
    _shaderdb_summary "$gpu" "$out" | tee -a "$srcdir/shaderdb-summary.metrics"
  done
  _shaderdb_compare "$srcdir/shaderdb-summary.metrics"
}

package() {
  meson install -C build --destdir "$pkgdir"
  # The simulated GPUs and the Intel tools were only for check().
  _remove_test_tools
  # Indirect GLX (remote X clients) through libglvnd, as Arch's mesa does.
  ln -sr "$pkgdir"/usr/lib/libGLX_{mesa,indirect}.so.0
  install -Dm644 mesa-$pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 llvm-project-$_llvmver.src/llvm/LICENSE.TXT \
    "$pkgdir/usr/share/licenses/$pkgname/LLVM-LICENSE.TXT"
}
