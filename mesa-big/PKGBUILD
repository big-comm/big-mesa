# Used to generate the above table
_gencrates() {
  grep '^source_url' subprojects/*-rs.wrap | \
    sed -r 's|.*crates/([^/]+)/([0-9.]+)/download|\1 \2|' | \
    column -t -S 2 | sed 's/^/  /'
}

for _crate in "${!_crates[@]}"; do
  _ver="${_crates[$_crate]}"
  source+=(
    "$_crate-$_ver.tar.gz::https://static.crates.io/crates/$_crate/$_ver/download"
  )
done

